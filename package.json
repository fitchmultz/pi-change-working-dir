{
  "name": "pi-change-working-dir",
  "version": "0.6.0",
  "description": "Let Pi agents change their working directory mid-session (worktrees, monorepos) without restarting.",
  "type": "module",
  "license": "MIT",
  "author": "Mitch Fultz (https://github.com/fitchmultz)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fitchmultz/pi-change-working-dir.git"
  },
  "homepage": "https://github.com/fitchmultz/pi-change-working-dir#readme",
  "bugs": {
    "url": "https://github.com/fitchmultz/pi-change-working-dir/issues"
  },
  "files": [
    "index.ts",
    "cwd-context.ts",
    "mutation-delegate.ts",
    "tool-wrapper.ts",
    "selection.ts",
    "native-paths.ts",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "keywords": [
    "pi-package",
    "pi-extension"
  ],
  "scripts": {
    "test": "node --test --test-concurrency=1 \"test*.ts\"",
    "typecheck": "tsc",
    "lint": "oxlint --deny-warnings .",
    "lint:agent": "oxlint --deny-warnings --format=agent .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "policy:check": "node scripts/check-policy.ts",
    "check:lock": "node -e \"process.exit(/workos|socket-firewall/i.test(require('fs').readFileSync('package-lock.json','utf8')) ? 1 : 0)\"",
    "pack:check": "npm pack --dry-run",
    "check": "node scripts/run-gates.ts check:lock policy:check format:check typecheck test pack:check",
    "check:compat": "node scripts/run-gates.ts check:lock policy:check format:check typecheck test",
    "prepublishOnly": "npm run check"
  },
  "engines": {
    "node": ">=24.15.0"
  },
  "packageManager": "npm@12.2.0",
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "1.0.0",
    "@earendil-works/pi-ai": "1.0.0",
    "@earendil-works/pi-coding-agent": "1.0.0",
    "@types/node": "24.19.1",
    "oxc-parser": "0.156.0",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "7.0.2005",
    "typebox": "1.3.27",
    "typescript": "7.0.2"
  }
}
