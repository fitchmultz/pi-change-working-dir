{
  "name": "pi-change-working-dir",
  "version": "0.5.2",
  "description": "Let Pi agents change their working directory mid-session (worktrees, monorepos) without restarting.",
  "type": "module",
  "license": "MIT",
  "author": "Mitch Fultz (https://github.com/fitchmultz)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fitchmultz/pi-change-working-dir.git"
  },
  "homepage": "https://github.com/fitchmultz/pi-change-working-dir#readme",
  "bugs": {
    "url": "https://github.com/fitchmultz/pi-change-working-dir/issues"
  },
  "files": [
    "index.ts",
    "cwd-context.ts",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "keywords": [
    "pi-package",
    "pi-extension"
  ],
  "scripts": {
    "test": "node --test --test-concurrency=1 \"test*.ts\"",
    "typecheck": "tsc",
    "check:lock": "node -e \"process.exit(/workos|socket-firewall/i.test(require('fs').readFileSync('package-lock.json','utf8')) ? 1 : 0)\"",
    "check": "npm run check:lock && npm run typecheck && npm test && npm pack --dry-run",
    "check:compat": "npm run check",
    "prepublishOnly": "npm run check"
  },
  "engines": {
    "node": ">=24.15.0"
  },
  "packageManager": "npm@12.1.0",
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "0.87.1",
    "@earendil-works/pi-ai": "0.87.1",
    "@earendil-works/pi-coding-agent": "0.87.1",
    "@types/node": "24.19.0",
    "typebox": "1.3.34",
    "typescript": "7.0.2"
  }
}
