{
  "name": "pi-change-working-dir",
  "version": "0.5.1",
  "description": "Let Pi agents change their working directory mid-session (worktrees, monorepos) without restarting.",
  "type": "module",
  "license": "MIT",
  "author": "Mitch Fultz (https://github.com/fitchmultz)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fitchmultz/pi-change-working-dir.git"
  },
  "homepage": "https://github.com/fitchmultz/pi-change-working-dir#readme",
  "bugs": {
    "url": "https://github.com/fitchmultz/pi-change-working-dir/issues"
  },
  "files": [
    "index.ts",
    "cwd-context.ts",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "keywords": [
    "pi-package",
    "pi-extension"
  ],
  "scripts": {
    "test": "node --experimental-strip-types test.ts && node --experimental-strip-types test-context.ts && node --experimental-strip-types test-render.ts",
    "test:bash": "node --experimental-strip-types test-bash.ts",
    "test:install": "node --experimental-strip-types test-install.ts",
    "typecheck": "tsc",
    "check": "npm run typecheck && npm test && npm run pack:check",
    "check:compat": "npm run check && npm run test:bash",
    "pack:check": "npm pack --dry-run",
    "prepublishOnly": "npm run check"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "0.87.1",
    "@earendil-works/pi-ai": "0.87.1",
    "@earendil-works/pi-coding-agent": "0.87.1",
    "@types/node": "24.12.4",
    "typebox": "1.3.7",
    "typescript": "5.9.3"
  }
}
